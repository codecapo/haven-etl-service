# Haven ETL service — config. Copy to .env and fill in.

# Where Parquet/CSV artifacts are written (default: ./data).
HAVEN_DATA_DIR=./data

# The national OS Open UPRN reference, held ONCE as Parquet (built by `os-uprn`).
OS_UPRN_PARQUET=./data/os_uprn.parquet

# Target council database (per-council silo). Each council has its OWN Postgres.
# Generic fallback used when no per-council URL is set:
SUPABASE_DB_URL=

# Per-council override (preferred): HAVEN_DB_URL__<COUNCIL>, e.g.
# HAVEN_DB_URL__CAMDEN=postgresql://user:pass@host:5432/postgres
# HAVEN_DB_URL__NEWHAM=postgresql://user:pass@host:5432/postgres
#
# Get the connection string from each council's Supabase: Project Settings →
# Database → Connection string (use the pooler URI, include the password).
